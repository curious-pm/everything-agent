# Everything Agent settings. Copy to the settings file the app uses (shown on its first start),
# or just fill in the keys on the setup screen. Everything except the two keys is optional.

# --- Keys (required) ---
# Hearing and speaking: https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Thinking: OpenRouter (https://openrouter.ai/keys) or any OpenAI-compatible provider.
LLM_API_KEY=

# --- AI model ---
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.5-flash
# openai (any OpenAI-compatible API) or ollama (local, e.g. LLM_BASE_URL=http://localhost:11434).
# Guessed from the address when empty.
LLM_PROVIDER=
# Let the model reason before answering: better at hard questions, about a second slower.
LLM_THINKING=false

# --- How Reachy talks ---
# auto replies in whatever language you speak; en, hi, fr, es or ja always use that one.
LANGUAGE_CODE=auto
CARTESIA_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# Empty uses the built-in friendly personality.
SYSTEM_PROMPT=
CARTESIA_TTS_MODEL=sonic-3
CARTESIA_STT_MODEL=ink-preview

# --- Listening ---
# How loud speech must be before Reachy listens (0.01-0.1); raise it in a noisy room.
VAD_THRESHOLD=0.03
# Silence that ends your turn, and the longer wait after "and", "um" or a trailing comma.
END_OF_TURN_SILENCE_MS=550
UNFINISHED_SILENCE_MS=1600
# Talking over Reachy stops its reply. Works best in a quiet room.
BARGE_IN_ENABLED=false
BARGE_IN_THRESHOLD=0.12
# Seconds of quiet before the speech-to-text connection closes (it reopens when you talk).
STT_IDLE_TIMEOUT_S=60

# --- Claude ---
# Hard questions (the web, careful thinking) go to Claude. Add either or both:
# an Anthropic API key (platform.claude.com), billed per question,
ANTHROPIC_API_KEY=
# or a setup token from `claude setup-token`, which uses your Claude plan.
CLAUDE_CODE_OAUTH_TOKEN=
# Which one to use when both are set: api_key or setup_token. The other is the backup.
CLAUDE_AUTH=api_key
CLAUDE_ENABLED=true
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_S=60

# --- Without the robot (laptop) ---
# Names as shown in the app's Settings; empty uses the system defaults.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
# Desktop app only: auto, real (wait for the robot) or mockup (never use the robot).
REACHY_MODE=auto

# --- Web page ---
WEB_PORT=8042
# Extra host names the page answers to; IP addresses, localhost and <hostname>.local always work.
WEB_ALLOWED_HOSTS=
# Set by the page itself the first time someone opens it (only a hash is stored).
WEB_PIN_HASH=
LOG_LEVEL=INFO
